# ---------------------------------------------------------------------------
# Employee Portal — environment template (copy to .env.local, never commit it).
# Client-safe values are the NEXT_PUBLIC_* ones; everything else is server-only.
# ---------------------------------------------------------------------------

# Shared Supabase project (also used by the sibling apps). Public URL + anon
# (publishable) key only — safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# SERVER ONLY. Service role key for the SHARED project. Used to resolve a
# username to its auth account, to read app_user_status, and for the Supabase
# Auth Admin API (create user, set password, revoke sessions). Never log it,
# never expose it and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER ONLY. Domain for the internal placeholder addresses of accounts created
# by an administrator (e.g. "<random>@employees.internal"). The address is never
# shown to anyone and nothing is ever sent to it, so use a domain you do not
# monitor — not a real mail domain.
PLACEHOLDER_EMAIL_DOMAIN=employees.internal

# Web Push. The public key is client-safe; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com

# Pharma/Nursing bridge (different Supabase project). Server only.
PHARMA_SUPABASE_URL=https://your-pharma-project.supabase.co
PHARMA_SUPABASE_SERVICE_ROLE_KEY=
