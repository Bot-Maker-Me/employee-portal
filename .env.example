# ============================================================================
# Employee Portal — environment template. Copy to `.env.local` and fill in.
# NOTHING here is a real secret; never commit a filled-in copy.
# ============================================================================

# ---------------------------------------------------------------------------
# Own Supabase project. Only the URL + publishable (anon) key belong in the
# client. The service-role key must NEVER appear in a NEXT_PUBLIC_* variable.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Web push (VAPID). The public key is shipped to the browser; the private key
# is server-only and must never be prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com

# ---------------------------------------------------------------------------
# Pharma / Nursing bridge — SERVER ONLY. There is no NEXT_PUBLIC_ variant of the
# service-role key, by design.
# ---------------------------------------------------------------------------
PHARMA_SUPABASE_URL=
PHARMA_SUPABASE_SERVICE_ROLE_KEY=
